<?xml version="1.0" ?>
<sdf version="1.7">
  <!--
    World: drone_delivery_field (centered at origin)
    Coordinate frame:
      +X → right
      +Y → forward
      +Z → up
    Layout based on Drone Delivery field diagram.
    H2: left side, H1: right side.
    Main field centered at (0,0,0).
  -->
  <world name="drone_delivery_field">

    <!-- Sunlight -->
    <include><uri>model://sun</uri></include>

    <!-- =========================
         MAIN FIELD & LINES
         ========================= -->

    <!-- Main field (18m x 12m), centered at origin -->
    <model name="main_field">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18 12 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>18 12 0.01</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Gray</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center horizontal white line -->
    <model name="central_line">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.5 0.2 0.02</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14.5 0.2 0.02</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Center vertical white line -->
    <model name="center_line_T3_T4">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.4 0.02</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.4 0.02</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         HOME LANDING PADS
         ========================= -->

    <!-- Home H2 pad (left side) -->
    <include>
      <uri>model://home_marker_H2</uri>
      <name>home_H2</name>
      <pose>-7.4 0 0.05 0 0 -1.57079633</pose>
    </include>

    <!-- Home H1 pad (right side) -->
    <include>
      <uri>model://home_marker_H1</uri>
      <name>home_H1</name>
      <pose>7.4 0 0.05 0 0 -1.57079633</pose>
    </include>

    <!-- Gray connection bar between H2 and T1 -->
    <model name="handoff_link">
      <static>true</static>
      <pose>-5.95 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.9 0.2 0.02</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.9 0.2 0.02</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =========================
         TARGETS (CONTACT AREAS)
         ========================= -->

    <!-- Target T1: Left side near H2 (large yellow) -->
    <model name="target_T1">
      <static>true</static>
      <pose>-4.5 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry><material><ambient>0.98 1.0 0.22 1</ambient><diffuse>0.98 1.0 0.22 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry></collision>
        <sensor name="contact_sensor_T1" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T1" filename="libgazebo_ros_bumper.so"><ros><namespace>/islab</namespace><remapping>bumper_states:=targets/T1/contacts</remapping></ros></plugin>
        </sensor>
      </link>
    </model>

    <!-- Target T2: Center (large yellow) -->
    <model name="target_T2">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry><material><ambient>0.98 1.0 0.22 1</ambient><diffuse>0.98 1.0 0.22 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry></collision>
        <sensor name="contact_sensor_T2" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T2" filename="libgazebo_ros_bumper.so"><ros><namespace>/islab</namespace><remapping>bumper_states:=targets/T2/contacts</remapping></ros></plugin>
        </sensor>
      </link>
    </model>

    <!-- Target T3: Below center (small red) -->
    <model name="target_T3">
      <static>true</static>
      <pose>0 -3.2 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry><material><ambient>0.99 0.16 0.11 1</ambient><diffuse>0.99 0.16 0.11 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry></collision>
        <sensor name="contact_sensor_T3" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T3" filename="libgazebo_ros_bumper.so"><ros><namespace>/islab</namespace><remapping>bumper_states:=targets/T3/contacts</remapping></ros></plugin>
        </sensor>
      </link>
    </model>

    <!-- Target T4: Above center (small red) -->
    <model name="target_T4">
      <static>true</static>
      <pose>0 3.2 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry><material><ambient>0.99 0.16 0.11 1</ambient><diffuse>0.99 0.16 0.11 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry></collision>
        <sensor name="contact_sensor_T4" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T4" filename="libgazebo_ros_bumper.so"><ros><namespace>/islab</namespace><remapping>bumper_states:=targets/T4/contacts</remapping></ros></plugin>
        </sensor>
      </link>
    </model>

    <!-- Target T5: Right side near H1 (small blue) -->
    <model name="target_T5">
      <static>true</static>
      <pose>3.5 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry><material><ambient>0.1 0.1 1 1</ambient><diffuse>0.1 0.1 1 1</diffuse></material></visual>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry></collision>
        <sensor name="contact_sensor_T5" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T5" filename="libgazebo_ros_bumper.so"><ros><namespace>/islab</namespace><remapping>bumper_states:=targets/T5/contacts</remapping></ros></plugin>
        </sensor>
      </link>
    </model>

    <!-- =========================
         RINGS (OBSTACLES)
         ========================= -->

    <!-- Ring R3: top-left corner -->
    <include>
      <uri>model://ring_1_8</uri>
      <name>ring_R3</name>
      <pose>-6.5 3.2 0 1.57079633 0 1.5708</pose>
    </include>

    <!-- Ring R2: bottom-left -->
    <include>
      <uri>model://ring_1_5</uri>
      <name>ring_R2</name>
      <pose>-1.5 -3.2 0 1.57079633 0 1.5708</pose>
    </include>

    <!-- Ring R1: top-right -->
    <include>
      <uri>model://ring_1_8</uri>
      <name>ring_R1</name>
      <pose>1.8 3.2 0 1.57079633 0 1.5708</pose>
    </include>
    
    <!-- =========================
      THIRD-PERSON CAMERA (Top-Right View)
      ========================= -->
    <include>
      <static>true</static>
      <uri>model://overview_camera</uri>
      <name>overview_camera</name>
      <pose>10 -10 12 0 0.7 2.35619</pose>
    </include>

    <!-- =========================
         ROS 2 INTEGRATION
         ========================= -->
    <plugin name="gazebo_ros" filename="libgazebo_ros_init.so">
      <ros><namespace>/gazebo</namespace></ros>
    </plugin>

    <plugin name="factory" filename="libgazebo_ros_factory.so"/>
  </world>
</sdf>

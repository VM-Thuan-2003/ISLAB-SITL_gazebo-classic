<sdf version="1.7">
  <world name="drone_delivery_field">
    <!-- Add sunlight to the world -->

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Main green field (18m x 12m) -->
    <model name="main_field">
      <static>true</static>
      <pose>9 6 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 12 0.01</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 12 0.01</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Gray</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central white path line (horizontal) -->
    <model name="central_line">
      <static>true</static>
      <!-- Positioned midway -->
      <pose>9 6.4 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <!-- Box dimensions: length (X), width (Y), height (Z) -->
          <geometry><box><size>14.5 0.2 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <!-- Box dimensions: length (X), width (Y), height (Z) -->
          <geometry><box><size>14.5 0.2 0.02</size></box></geometry>
          <material>
            <!-- White line -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center line from T3 to T4 -->
    <model name="center_line_T3_T4">
      <static>true</static>
      <!-- Positioned midway between T3 and T4 -->
      <pose>10.5 6.4 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <!-- Box dimensions: width (X), length (Y), height (Z) -->
            <box><size>0.2 6.4 0.02</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <!-- Box dimensions: width (X), length (Y), height (Z) -->
            <box><size>0.2 6.4 0.02</size></box>
          </geometry>
          <material>
            <!-- White line -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================= -->
    <!-- HOME LANDING PADS WITH CONTACT SENSORS -->
    <!-- ========================= -->

    <!-- Home H1 landing pad -->
    <include>
      <uri>model://home_marker_H1</uri>
      <name>home_H1</name>
      <pose>1.6 6.4 0.05 0 0 -1.57079633</pose>
    </include>

    <!-- Home H2 landing pad -->
    <include>
      <uri>model://home_marker_H2</uri>
      <name>home_H2</name>
      <pose>16.4 6.4 0.05 0 0 -1.57079633</pose>
    </include>

    <!-- ========================= -->
    <!-- TARGETS WITH CONTACT SENSOR -->
    <!-- ========================= -->

    <model name="target_T1">
      <static>true</static>
      <pose>6.5 6.4 0.05 0 0 0</pose>
      <link name="link">

        <!-- Visual appearance -->
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.1</length></cylinder>
          </geometry>
          <material>
            <ambient>0.98 1.0 0.22 1</ambient>
            <diffuse>0.98 1.0 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Collision geometry -->
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.5</radius><length>0.1</length></cylinder>
          </geometry>
          <surface>
            <contact><ode/></contact>
            <bounce/><friction/>
          </surface>
        </collision>

        <!-- Contact sensor publishing ROS2 ContactsState -->
        <sensor name="contact_sensor_T1" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact>
            <collision>collision</collision>
          </contact>
          <plugin name="gazebo_ros_bumper_T1" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/islab</namespace>
              <remapping>bumper_states:=targets/T1/contacts</remapping>
            </ros>
          </plugin>
        </sensor>

      </link>
    </model>

    <model name="target_T2">
      <static>true</static>
      <pose>10.5 6.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.98 1.0 0.22 1</ambient><diffuse>0.98 1.0 0.22 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry>
          <surface><contact><ode/></contact><bounce/><friction/></surface>
        </collision>
        <sensor name="contact_sensor_T2" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T2" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/islab</namespace>
              <remapping>bumper_states:=targets/T2/contacts</remapping>
            </ros>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="target_T3">
      <static>true</static>
      <pose>10.5 3.2 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.99 0.16 0.11 1</ambient><diffuse>0.99 0.16 0.11 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <surface><contact><ode/></contact><bounce/><friction/></surface>
        </collision>
        <sensor name="contact_sensor_T3" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T3" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/islab</namespace>
              <remapping>bumper_states:=targets/T3/contacts</remapping>
            </ros>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="target_T4">
      <static>true</static>
      <pose>10.5 9.6 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.99 0.16 0.11 1</ambient><diffuse>0.99 0.16 0.11 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <surface><contact><ode/></contact><bounce/><friction/></surface>
        </collision>
        <sensor name="contact_sensor_T4" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T4" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/islab</namespace>
              <remapping>bumper_states:=targets/T4/contacts</remapping>
            </ros>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="target_T5">
      <static>true</static>
      <pose>14.5 6.4 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.1 0.1 1 1</ambient><diffuse>0.1 0.1 1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.1</length></cylinder></geometry>
          <surface><contact><ode/></contact><bounce/><friction/></surface>
        </collision>
        <sensor name="contact_sensor_T5" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="gazebo_ros_bumper_T5" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/islab</namespace>
              <remapping>bumper_states:=targets/T5/contacts</remapping>
            </ros>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Ring R1 using ring_1_8 model -->
    <include>
      <uri>model://ring_1_8</uri>
      <name>ring_R1</name>
      <pose>15.5 9.6 0 1.57079633 0 1.5708</pose>
    </include>

    <!-- Ring R2 using ring_1_5 model -->
    <include>
      <uri>model://ring_1_5</uri>
      <name>ring_R2</name>
      <pose>8.5 3.2 0 1.57079633 0 1.5708</pose>
    </include>

    <!-- Ring R3 using ring_1_8 model -->
    <include>
      <uri>model://ring_1_8</uri>
      <name>ring_R3</name>
      <pose>2.0 9.6 0 1.57079633 0 1.5708</pose>
    </include>

    <!-- ROS 2 integration plugins -->
    <plugin name="gazebo_ros" filename="libgazebo_ros_init.so">
      <ros><namespace>/gazebo</namespace></ros>
    </plugin>

    <plugin name="factory" filename="libgazebo_ros_factory.so"/>
  </world>
</sdf>

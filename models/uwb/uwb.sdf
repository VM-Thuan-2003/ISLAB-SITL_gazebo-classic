<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="uwb_sensor">
    <static>true</static>
    <link name="uwb_link">
      <pose>0 0 0.5 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0.8 1 1</ambient>
          <diffuse>0 0.8 1 1</diffuse>
        </material>
      </visual>

      <sensor name="uwb_range" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <plugin name="uwb_plugin" filename="libgazebo_ros_range.so">
          <ros>
            <namespace>/uwb</namespace>
          </ros>
          <frame_name>uwb_link</frame_name>
          <topic_name>range</topic_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
